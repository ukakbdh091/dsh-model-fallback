{
  "name": "dsh-model-fallback",
  "version": "0.5.1",
  "type": "module",
  "description": "模型报错时自动切到备用模型并在同一步重试，备用模型可在设置页从模型列表里选。",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ukakbdh091/dsh-model-fallback#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukakbdh091/dsh-model-fallback.git"
  },
  "bugs": {
    "url": "https://github.com/ukakbdh091/dsh-model-fallback/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "fallback",
    "model-switch",
    "quota",
    "retry"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/boot.mjs && node test/client.mjs",
    "test:host": "node test/smoke.mjs",
    "test:boot": "node test/boot.mjs",
    "test:client": "node test/client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cosmokit": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
